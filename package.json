{
  "name": "carbon-credit",
  "version": "1.0.0",
  "private": false,
  "description": "Local dashboard estimating the electricity and carbon of your own Claude Code usage, per day and per week, in units you can picture. Reads local session transcripts; nothing is uploaded.",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "energy",
    "carbon",
    "co2",
    "sustainability",
    "llm",
    "inference",
    "dashboard",
    "nextjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "typescript": "^5"
  }
}
